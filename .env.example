# Audio Processing Configuration
CHUNK_LENGTH_SECONDS=900
SUPPORTED_EXTENSIONS=.mp4,.m4a,.wav,.mov,.mkv

# Language Routing
# Comma-separated list of language codes that use the Dutch route (monolithic, no diarization)
DUTCH_LANGUAGE_CODES=nl-NL
# Comma-separated list of language codes that use the English route (chunked, with diarization)
ENGLISH_LANGUAGE_CODES=en-US,en-GB

# Directory Configuration
OUTPUT_DIR=output

# GCP Configuration (required for transcription)
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCP_REGION=eu
TRANSCRIPTION_MODEL=chirp_3
TRANSCRIPT_OUTPUT_DIR=transcripts
TRANSCRIPTION_TIMEOUT=600
