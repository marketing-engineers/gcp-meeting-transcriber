# Audio Processing Configuration
CHUNK_MAX_LENGTH_SECONDS_DUTCH=2700
CHUNK_MAX_LENGTH_SECONDS_ENGLISH=2700
CHUNK_MIN_LENGTH_SECONDS=600
CHUNK_SILENCE_SEARCH_WINDOW_SECONDS=15
CHUNK_SILENCE_NOISE_THRESHOLD_DB=-30
CHUNK_SILENCE_MIN_DURATION_SECONDS=0.5
SUPPORTED_EXTENSIONS=.mp4,.m4a,.wav,.mov,.mkv

# Language Routing
LANGUAGE_CODES_DUTCH=nl-NL
LANGUAGE_CODES_ENGLISH=en-US,en-GB

# Directory Configuration
OUTPUT_DIR=output
TRANSCRIPT_OUTPUT_DIR=transcripts

# Transcript Formatting Configuration
TRANSCRIPTION_MAX_CHARS_PER_LINE=120
TRANSCRIPTION_MAX_SENTENCES_PER_LINE=3

# GCP Configuration (required for transcription)
GCP_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCP_REGION=eu
TRANSCRIPTION_MODEL=chirp_3
TRANSCRIPTION_CONCURRENCY=5
TRANSCRIPTION_MAX_TIMEOUT_SECONDS=1800
GCS_UPLOAD_TIMEOUT_SECONDS=600
# Optional custom prompt override for Chirp 3 models only
# TRANSCRIPTION_CUSTOM_PROMPT="Insert line breaks at natural sentence boundaries."

# GCP Authentication Configuration
# Mode: 'adc' (default, local workstation with user gcloud login)
#       'service_account_key' (automated / Hermes deployment using least-privilege service account key)
GCP_AUTH_MODE=adc

# Required when GCP_AUTH_MODE=service_account_key:
# Note: Hermes deployments use a separate checkout/.env on the server.
# In key mode, GCP_PROJECT_ID must be the string project ID, not the numeric project number.
# GCP_SERVICE_ACCOUNT_KEY_FILE=/home/hermes/.config/gcp-audio-transcribe/hermes-sa.json
# GCP_EXPECTED_SERVICE_ACCOUNT=hermes-transcriber@your-project-id.iam.gserviceaccount.com

