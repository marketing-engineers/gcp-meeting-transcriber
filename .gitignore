# Virtual environment
venv/

# Environment variables (may contain secrets)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# Service account keys & credentials (never commit credentials)
service-account*.json
credentials*.json
*.pem
*.key

# Data directories (deny by default, retain .gitkeep)
input/*
!input/.gitkeep
output/*
!output/.gitkeep
transcripts/*
!transcripts/.gitkeep
logs/*
!logs/.gitkeep

# Global media and artifact catch-alls
*.m4a
*.mp4
*.mov
*.mkv
*.wav
*.flac
*.aac
*.ogg
*.webm
*_raw.json
*_transcript.txt
*.log

# OS files
.DS_Store
Thumbs.db

# IDE & editors
.vscode/
.idea/
*.swp
*.swo

# AI Agent Workspaces & Local config
.kilo/
.cursor/
.cline/
.roo/
.aider/
.windsurf/
.copilot/
