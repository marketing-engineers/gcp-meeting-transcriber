# Virtual environment
venv/

# Environment variables (may contain secrets)
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Output artifacts (generated files, not source)
output/*
!output/.gitkeep

# Transcripts (generated output)
transcripts/*
!transcripts/.gitkeep

# Generated audio files
*.flac

# Service account keys (never commit credentials)
service-account*.json
credentials*.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Input audio files (ignore media, keep folder)
input/*
!input/.gitkeep

# AI Agent Workspaces
.kilo/
.cursor/
.cline/
.roo/
.aider/
.windsurf/
.copilot/
